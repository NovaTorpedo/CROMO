#!/bin/sh
# CROMO pre-commit: syntax check, local secret scan (+ gitleaks if installed).
PY=".venv/Scripts/python"; [ -x "$PY" ] || PY=".venv/bin/python"; [ -x "$PY" ] || PY="python3"
"$PY" -m compileall -q backend/cromo scripts eval generator >/dev/null || { echo "Python syntax error - commit aborted"; exit 1; }
"$PY" scripts/secret_scan.py --staged || exit 1
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml || exit 1
fi
