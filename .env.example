# CROMO configuration. Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Without any AMD endpoint, CROMO runs in OFFLINE FIXTURE MODE (clearly labelled in the UI).

# ---------------------------------------------------------------- AMD models
# fixture = offline deterministic provider; amd = use the OpenAI-compatible AMD endpoints below
CROMO_PROVIDER=fixture
# tokenfactory = AMD Token Factory (event API, shared endpoints on AMD GPUs); vllm = own vLLM on AMD Developer Cloud
CROMO_AMD_ROUTE=vllm

# AMD Token Factory: one team key for every model (format rc- + 48 hex characters, from notebooks.amd.com/tokenfactory).
# With CROMO_AMD_ROUTE=tokenfactory every role below defaults to this endpoint and key, so only the model names are
# needed, e.g. CROMO_REASONER_MODEL=Gemma-4-31B-IT, CROMO_VISION_MODEL=Gemma-4-31B-IT, CROMO_EMBEDDINGS_MODEL= (none).
AMD_TOKEN_FACTORY=
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Client-side pacing per key. Defaults on the Token Factory route: 18 requests/min, 6 concurrent, 600 s timeout.
CROMO_RPM_LIMIT=

# Default: Google DeepMind's Gemma 4 (Apache-2.0) serves BOTH the reasoner and the vision role from one vLLM server.
# REASONER - main LLM (investigations, tripwires, trial plans). e.g. http://<droplet-ip>:8000/v1
CROMO_REASONER_BASE_URL=
CROMO_REASONER_API_KEY=
CROMO_REASONER_MODEL=google/gemma-4-26B-A4B-it

# VISION - reads scans, faxes and handwritten logbooks. With Gemma 4 it is the same server as the reasoner (:8000)
CROMO_VISION_BASE_URL=
CROMO_VISION_API_KEY=
CROMO_VISION_MODEL=google/gemma-4-26B-A4B-it

# Optional second vision model for the A/B quality test (scripts/compare_models.py vision), e.g. :8001
CROMO_VISION_ALT_BASE_URL=
CROMO_VISION_ALT_API_KEY=
CROMO_VISION_ALT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# EMBEDDINGS - retrieval embeddings. e.g. http://<droplet-ip>:8002/v1
CROMO_EMBEDDINGS_BASE_URL=
CROMO_EMBEDDINGS_API_KEY=
CROMO_EMBEDDINGS_MODEL=BAAI/bge-m3

# Optional SPEECH role (not used yet)
CROMO_SPEECH_BASE_URL=
CROMO_SPEECH_API_KEY=
CROMO_SPEECH_MODEL=

# json_schema | json_object | none  (scripts/check_amd.py tells you which one your endpoint supports)
CROMO_STRUCTURED_OUTPUT=json_object
# empty = route default (vllm: 8 concurrent, 120 s; tokenfactory: 6 concurrent, 600 s)
CROMO_MAX_CONCURRENCY=
CROMO_REQUEST_TIMEOUT_S=
# optional reasoning effort for the REASONER (Token Factory: none|low|medium|high; Gemma does not think unless asked)
CROMO_REASONING_EFFORT=
# empty = route default ("AMD Token Factory (shared endpoints on AMD GPUs)" or "AMD Instinct MI300X ..., ROCm + vLLM")
CROMO_HARDWARE_LABEL=
# Price used for "cost per plant audit" (USD per GPU-hour) and where it comes from
CROMO_GPU_PRICE_PER_HOUR=1.99
CROMO_GPU_PRICE_SOURCE=AMD Developer Cloud list price, 1x MI300X: https://docs.digitalocean.com/products/amd/details/pricing/

# ---------------------------------------------------------------- Evolus (partner track)
# API keys page of your Evolus workspace; the space ID is the X-Application-Id
EVOLUS_APPLICATION_ID=
EVOLUS_API_KEY=
# Created in the workspace - see docs/EVOLUS_SETUP.md
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_TRIAL_WORKFLOW_ID=
EVOLUS_LIBRARY_ID=
# applicationId:agentId of the plant agent (GET https://api.evolus.ai/v1/models lists them)
EVOLUS_AGENT_MODEL=
# false disables every Evolus call (tests do this)
CROMO_EVOLUS_ENABLED=true
# auto = use cached Evolus extractor results when present, else the reasoner; or: reasoner | evolus | fixture
CROMO_METADATA_SOURCE=auto

# ---------------------------------------------------------------- public deployment
# Passcode for every action that writes data, calls a model or spends Evolus credits (sent as X-Access-Token).
# Empty = those actions only work for direct callers on this machine or a private network (local development);
# anyone else gets 403. Set a long random value on any deployment reachable from the internet, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CROMO_ACCESS_TOKEN=
# Comma-separated origins allowed by CORS (empty = same origin only)
CROMO_ALLOWED_ORIGINS=
# Interactive API docs at /api/docs-ui (development only; off by default)
CROMO_API_DOCS=false
